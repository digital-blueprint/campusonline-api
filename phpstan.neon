includes:
    - vendor/phpstan/phpstan-phpunit/extension.neon

parameters:
    inferPrivatePropertyTypeFromConstructor: true
    reportUnmatchedIgnoredErrors: false
    level: 5
    paths:
        - src
        - tests
    excludePaths:
        - tests/bootstrap.php
    ignoreErrors:
        - identifier: method.alreadyNarrowedType
        - identifier: function.alreadyNarrowedType
